# Backend Environment Template (copy to .env or export in shell — never commit real secrets)
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/secureauth?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=secureauth_user
DB_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD
JWT_SECRET=REPLACE_WITH_64_BYTE_RANDOM_BASE64_SECRET
JWT_EXPIRATION_MS=3600000
JWT_REMEMBER_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Development seed accounts (set APP_SEED_DEV_USERS=true locally; keep false in production)
APP_SEED_DEV_USERS=false
SEED_ADMIN_EMAIL=admin@secureauth.dev
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=alex@secureauth.dev
SEED_USER_PASSWORD=
